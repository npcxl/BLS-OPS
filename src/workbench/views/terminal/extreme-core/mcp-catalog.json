{
  "version": 2,
  "entries": [
    {
      "id": "grafana",
      "name": "Grafana Cloud",
      "publisher": "Grafana Labs",
      "category": "monitor",
      "summary": "查询 Grafana Cloud 的仪表盘、指标与告警",
      "detail": "Grafana Cloud 的远程 MCP Endpoint。需要 Stack 名称与 Service Account Token；自建实例请使用「Grafana（自建）」。",
      "transport": "http",
      "urlTemplate": "https://{stack}.grafana.net/api/mcp",
      "auth": "bearer",
      "availability": "addable",
      "availabilityNote": "需要 Grafana Cloud 实例与 Service Account Token；Token 会写入系统钥匙串。",
      "docsUrl": "https://grafana.com/docs/grafana/latest/developers/mcp/",
      "upstreamUrl": "https://github.com/grafana/mcp-grafana",
      "defaultBinding": "workspace",
      "configFields": [
        {
          "key": "stack",
          "label": "Grafana Cloud Stack",
          "placeholder": "my-stack",
          "required": true,
          "apply": "url"
        },
        {
          "key": "token",
          "label": "Service Account Token",
          "placeholder": "glsa_…",
          "required": true,
          "secret": true,
          "apply": "header",
          "target": "Authorization",
          "prefix": "Bearer "
        }
      ]
    },
    {
      "id": "grafana-self-hosted",
      "name": "Grafana（自建）",
      "publisher": "Grafana Labs",
      "category": "monitor",
      "summary": "查询自建 Grafana 的仪表盘、指标与告警",
      "detail": "自建 Grafana 的 MCP Endpoint。需要 Grafana 11.5+ 并开启 MCP；地址中的域名必须能从运行 BLS-OPS 的电脑访问。",
      "transport": "http",
      "urlTemplate": "https://{host}/api/mcp",
      "auth": "bearer",
      "availability": "addable",
      "availabilityNote": "需要 Grafana 11.5+、已开启 MCP，并使用 Service Account Token。",
      "docsUrl": "https://grafana.com/docs/grafana/latest/developers/mcp/",
      "upstreamUrl": "https://github.com/grafana/mcp-grafana",
      "defaultBinding": "workspace",
      "configFields": [
        {
          "key": "host",
          "label": "Grafana 域名",
          "placeholder": "grafana.example.com",
          "required": true,
          "apply": "url"
        },
        {
          "key": "token",
          "label": "Service Account Token",
          "placeholder": "glsa_…",
          "required": true,
          "secret": true,
          "apply": "header",
          "target": "Authorization",
          "prefix": "Bearer "
        }
      ]
    },
    {
      "id": "kubernetes",
      "name": "Kubernetes",
      "publisher": "CNCF",
      "category": "container",
      "summary": "查看 Pod、Deployment、事件与集群资源",
      "detail": "本地 stdio 服务：在运行 BLS-OPS 的电脑上启动，不在 SSH 服务器上；使用本机 kubeconfig，需要 PATH 中有 npx。",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "kubernetes-mcp-server@latest"],
      "auth": "none",
      "availability": "local-runtime",
      "availabilityNote": "需要本机安装 Node/npx，并具备可用的 kubeconfig 与集群权限。",
      "docsUrl": "https://github.com/containers/kubernetes-mcp-server",
      "upstreamUrl": "https://github.com/containers/kubernetes-mcp-server",
      "defaultBinding": "workspace",
      "configFields": [
        {
          "key": "kubeconfig",
          "label": "KUBECONFIG（可选）",
          "placeholder": "/home/ops/.kube/config",
          "required": false,
          "apply": "env",
          "target": "KUBECONFIG"
        }
      ]
    },
    {
      "id": "github-actions",
      "name": "GitHub Actions",
      "publisher": "GitHub",
      "category": "cicd",
      "summary": "查看工作流运行、日志与仓库信息",
      "detail": "GitHub 官方远程 MCP。官方推荐 OAuth；当前客户端未实现浏览器 OAuth，可粘贴具备仓库权限的 Personal Access Token 作为 Bearer。",
      "transport": "http",
      "urlTemplate": "https://api.githubcopilot.com/mcp/",
      "auth": "oauth",
      "availability": "oauth",
      "availabilityNote": "官方流程使用 OAuth。当前版本可改用 PAT（Authorization: Bearer）；未提供 OAuth 浏览器回调。",
      "docsUrl": "https://docs.github.com/en/copilot/how-tos/context/model-context-protocol",
      "upstreamUrl": "https://github.com/github/github-mcp-server",
      "defaultBinding": "workspace",
      "configFields": [
        {
          "key": "token",
          "label": "GitHub Token（PAT）",
          "placeholder": "github_pat_…",
          "required": true,
          "secret": true,
          "apply": "header",
          "target": "Authorization",
          "prefix": "Bearer "
        }
      ]
    },
    {
      "id": "cloudflare",
      "name": "Cloudflare",
      "publisher": "Cloudflare",
      "category": "cloud",
      "summary": "查询 DNS、Zone、Workers 与可观测数据",
      "detail": "Cloudflare 远程 MCP（Streamable HTTP）。上游使用 OAuth 2.1；当前客户端没有 OAuth 回调，若服务接受 API Token，可用 Bearer 连接，否则请使用官方客户端。旧版 SSE 端点不在支持范围内。",
      "transport": "http",
      "urlTemplate": "https://observability.mcp.cloudflare.com/mcp",
      "auth": "oauth",
      "availability": "oauth",
      "availabilityNote": "上游使用 OAuth 2.1。当前客户端可尝试 API Token（Bearer）；不支持浏览器 OAuth 回调与旧版 SSE。",
      "docsUrl": "https://developers.cloudflare.com/agents/model-context-protocol/",
      "upstreamUrl": "https://github.com/cloudflare/mcp-server-cloudflare",
      "defaultBinding": "workspace",
      "configFields": [
        {
          "key": "token",
          "label": "Cloudflare API Token",
          "placeholder": "…",
          "required": true,
          "secret": true,
          "apply": "header",
          "target": "Authorization",
          "prefix": "Bearer "
        }
      ]
    },
    {
      "id": "aliyun-cloudops",
      "name": "阿里云 CloudOps",
      "publisher": "Alibaba Cloud",
      "category": "cloud",
      "summary": "查询云资源、监控与运维事件",
      "detail": "不同地域 / 实例的 MCP Endpoint 可能不同，请按官方控制台给出的 Streamable HTTP 地址填写。",
      "transport": "http",
      "urlTemplate": "{endpoint}",
      "auth": "bearer",
      "availability": "addable",
      "availabilityNote": "需要控制台提供的 MCP Endpoint 与访问令牌。",
      "docsUrl": "https://www.aliyun.com/product/cloudops",
      "upstreamUrl": "https://www.aliyun.com/product/cloudops",
      "defaultBinding": "workspace",
      "configFields": [
        {
          "key": "endpoint",
          "label": "MCP Endpoint",
          "placeholder": "https://…/mcp",
          "required": true,
          "apply": "url"
        },
        {
          "key": "token",
          "label": "访问令牌",
          "required": true,
          "secret": true,
          "apply": "header",
          "target": "Authorization",
          "prefix": "Bearer "
        }
      ]
    },
    {
      "id": "aws-eks",
      "name": "AWS EKS",
      "publisher": "AWS Labs",
      "category": "container",
      "summary": "查看 EKS 集群、节点与工作负载",
      "detail": "本地 stdio 服务，在运行 BLS-OPS 的电脑上启动；依赖 uvx（uv）与本机 AWS 凭据，未安装 uvx 时不可用。",
      "transport": "stdio",
      "command": "uvx",
      "args": ["awslabs.eks-mcp-server@latest"],
      "auth": "none",
      "availability": "local-runtime",
      "availabilityNote": "需要本机安装 uv/uvx，并配置可访问目标集群的 AWS 凭据。",
      "docsUrl": "https://github.com/awslabs/mcp",
      "upstreamUrl": "https://github.com/awslabs/mcp",
      "defaultBinding": "workspace",
      "configFields": [
        {
          "key": "region",
          "label": "AWS_REGION",
          "placeholder": "ap-southeast-1",
          "required": false,
          "apply": "env",
          "target": "AWS_REGION"
        },
        {
          "key": "profile",
          "label": "AWS_PROFILE",
          "placeholder": "default",
          "required": false,
          "apply": "env",
          "target": "AWS_PROFILE"
        }
      ]
    },
    {
      "id": "aws-cloudwatch",
      "name": "AWS CloudWatch",
      "publisher": "AWS Labs",
      "category": "monitor",
      "summary": "查询日志组、指标与告警",
      "detail": "本地 stdio 服务，在运行 BLS-OPS 的电脑上启动；依赖 uvx 与本机 AWS 凭据。",
      "transport": "stdio",
      "command": "uvx",
      "args": ["awslabs.cloudwatch-mcp-server@latest"],
      "auth": "none",
      "availability": "local-runtime",
      "availabilityNote": "需要本机安装 uv/uvx，并配置 AWS 凭据与目标区域。",
      "docsUrl": "https://github.com/awslabs/mcp",
      "upstreamUrl": "https://github.com/awslabs/mcp",
      "defaultBinding": "workspace",
      "configFields": [
        {
          "key": "region",
          "label": "AWS_REGION",
          "placeholder": "ap-southeast-1",
          "required": false,
          "apply": "env",
          "target": "AWS_REGION"
        }
      ]
    }
  ]
}
