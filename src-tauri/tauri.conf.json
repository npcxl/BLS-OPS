{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ops Workbench",
  "version": "0.1.6",
  "identifier": "com.bls.ops",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Ops Workbench",
        "label": "main",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: wss:; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwMzYyMENENDA2OTc5NTcKUldSWGVXbEF6U0EyTUl5SWV5U2RFS01JQnhiVWptV3RFSWJIWFZJY3R5R3RtYkFGcEtuWWpFaWkK",
      "endpoints": [
        "https://github.com/npcxl/BLS-OPS/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
