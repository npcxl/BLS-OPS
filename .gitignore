# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Shell redirection leftovers from package manager invocations
*.err

node_modules
dist
dist-ssr
*.local

# Rust build artifacts（含验证用的临时 CARGO_TARGET_DIR，一律不入库）
src-tauri/target*/

# Updater signing keys — NEVER commit the private key or its password.
# The public key lives in src-tauri/tauri.conf.json (plugins.updater.pubkey);
# the private key + password live in GitHub Actions Secrets only.
.tauri/
*.key
*.key.pub
*.key.pass

# Local verification leftovers (build / test 输出与临时脚本)
*_out.txt
scripts/tmp-*
.tmp-*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
